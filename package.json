{
  "name": "omarchy-theme-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node scripts/build.js && bun x serve out -p 3000",
    "serve": "bun x serve out -p 3000",
    "deploy": "bun run build && bun x wrangler pages deploy out/ --project-name=omarchy-theme-website"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "marked": "^18.0.9",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.3",
    "smol-toml": "^1.8.0",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.123.0"
  },
  "dependencies": {
    "@sentry/cloudflare": "^10.70.0"
  }
}
