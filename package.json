{
  "name": "omarchy-theme-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev --port 3000",
    "preview": "astro preview --port 3000",
    "serve": "bun x serve out -p 3000",
    "test": "bun test",
    "deploy": "bun run build && bun x wrangler pages deploy out/ --project-name=omarchy-theme-website"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "marked": "^18.1.1",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "smol-toml": "^1.9.1",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.153.0"
  }
}
