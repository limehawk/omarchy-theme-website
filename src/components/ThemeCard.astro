---
import { parseColors, getThemeBrightness } from "../../scripts/colors.js";
import { searchText } from "../lib/search.js";
import { terminalPreviewCard } from "../lib/terminal.js";

const { theme } = Astro.props;
const colors = parseColors(theme.colors_json);
const accent = colors?.accent ?? "#4a9eff";
const brightness = getThemeBrightness(theme.colors_json);
const pushed = new Date(theme.github_pushed_at ?? theme.created_at).getTime();
const THUMB_SIZES = "(max-width: 640px) calc(100vw - 48px), (max-width: 1024px) calc(50vw - 36px), 352px";
const widths = Array.isArray(theme.thumbnail_widths) ? theme.thumbnail_widths : [];
const terminal = terminalPreviewCard({ colors, slug: theme.slug, themeName: theme.name });
---
<a data-theme-card
  data-name={theme.name}
  data-desc={(theme.description ?? "").toLowerCase()}
  data-search={searchText(theme)}
  data-author={theme.github_owner}
  data-hue={theme.primary_hue ?? ""}
  data-brightness={brightness}
  data-stars={theme.stars}
  data-pushed={pushed}
  data-builtin={theme.is_builtin}
  href={`/themes/${theme.slug}/`}
  class="theme-card group relative flex flex-col rounded-xl border border-border/40 bg-card overflow-hidden hover:border-[var(--card-accent)] transition-colors"
  style={`--card-accent:${accent}`}>
  {theme.overlays_builtin && (
    <span class="absolute top-2 left-2 z-10 inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md bg-background/80 backdrop-blur-sm border border-border/40 text-[9px] font-mono text-muted-foreground" title={`overlays builtin ${theme.overlays_builtin}`}>
      <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
      {theme.overlays_builtin}
    </span>
  )}
  {theme.preview_url ? (
    <>
      <div class="hero-screenshot relative aspect-[16/10] overflow-hidden">
        {widths.length > 0 ? (
          <img
            src={`/thumbs/${theme.slug}-${widths.reduce((a, b) => (Math.abs(b - 800) < Math.abs(a - 800) ? b : a))}.webp`}
            srcset={widths.map((w) => `/thumbs/${theme.slug}-${w}.webp ${w}w`).join(", ")}
            sizes={THUMB_SIZES}
            alt={theme.name}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover"
          />
        ) : (
          <img src={theme.preview_url} alt={theme.name} loading="lazy" decoding="async" class="w-full h-full object-cover" />
        )}
      </div>
      <div class="hero-terminal relative aspect-[16/10] overflow-hidden" set:html={terminal} />
    </>
  ) : (
    <div class="relative aspect-[16/10] overflow-hidden" set:html={terminal} />
  )}
  <div class="p-3 space-y-1 grow">
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-mono text-sm font-medium text-foreground truncate">{theme.name}</h3>
      {theme.stars > 0 && (
        <span class="badge font-mono text-xs gap-1 shrink-0 inline-flex items-center">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15 8.5 22 9.3 17 14 18 21 12 17.8 6 21 7 14 2 9.3 9 8.5 12 2"/></svg>
          {theme.stars}
        </span>
      )}
    </div>
    <span data-author-link={theme.github_owner} role="button" tabindex="0" class="font-mono text-[10px] text-muted-foreground truncate block cursor-pointer hover:text-foreground transition-colors">{theme.github_owner}</span>
  </div>
  {colors && (
    <div class="flex h-1.5 overflow-hidden">
      {[...Array(16)].map((_, i) => (
        colors[`color${i}`] ? <div class="flex-1" style={`background-color:${colors[`color${i}`]}`}></div> : null
      ))}
    </div>
  )}
</a>
